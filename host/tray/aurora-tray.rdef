/* aurora-tray: the Deskbar add-on for Aurora apps' Tray icons. Deskbar finds
   it by this signature, which the items it shows name as their add-on. */

resource app_signature "application/x-vnd.aurora-tray";

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Aurora tray",
	long_info = "Aurora: Tray icons of Electron apps in Deskbar"
};
