/* aurora-host: the native half of the Aurora runtime. Every Electron app
   runs its own host, so the host may run many times at once. */

resource app_signature "application/x-vnd.aurora-app";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Aurora",
	long_info = "Aurora: Electron apps on Haiku"
};
