/* The pgAdmin 4 launcher: aurora-host with pgAdmin's name, icon and
   signature (see host/Launcher.h). Multiple launch: the runtime starts this
   executable once more as its host only when run outside the package. */

resource app_signature "application/x-vnd.pgadmin-pgadmin4";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 9,
	middle = 18,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "pgAdmin 4",
	long_info = "pgAdmin 4: the administration and development platform for PostgreSQL, running on Aurora"
};

resource(101, "BEOS:ICON") #'VICN' import "pgAdmin4.hvif";
